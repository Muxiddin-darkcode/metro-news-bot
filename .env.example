# Telegram Bot Token (Telegram @BotFather dan olinadi)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Admin Telegram User IDlari (3 ta alohida o'zgaruvchida)
# Telegramda @userinfobot orqali o'z IDingizni bilib olishingiz mumkin
ADMIN_ID_1=6648563749
ADMIN_ID_2=240775367
ADMIN_ID_3=337332277

# Yoki bitta qatorda vergul bilan (ixtiyoriy)
ADMIN_IDS=6648563749,240775367,337332277

# Guruh yoki kanal ID si (ixtiyoriy, masalan: -1001234567890)
# Guruhga botni admin qilib qo'shgach, guruhda /id deb yozsangiz bot ID sini beradi
GROUP_ID=

# Manbalarni tekshirish intervali (soniyalarda, default: 60 soniya = 1 daqiqa)
CHECK_INTERVAL_SECONDS=60

# Bir vaqtning o'zida nechta manba parallel so'ralishi (Semaphore limit)
MAX_CONCURRENT_REQUESTS=15

# Kross-dublikat o'xshashlik chegarasi (0.65 = 65% o'xshash bo'lsa ikkinchi xabar yuborilmaydi)
SIMILARITY_THRESHOLD=0.65

# =========================================================================
# AI TAHLILCHI SOZLAMALARI (GEMINI + OPENROUTER DUAL PROVIDER)
# =========================================================================
# AI tahlilini yoqish/o'chirish (True / False)
AI_ENABLED=True

# Google Gemini API Kaliti (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter API Kaliti (https://openrouter.ai/keys - Gemini limiti tugaganda avtomatik o'tadi)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
AI_TIMEOUT=20.0
