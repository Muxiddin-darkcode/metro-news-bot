# Telegram Bot Token (Telegram @BotFather dan olinadi)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2 ta Admin Telegram User IDlari (vergul bilan ajratilgan)
# Telegramda @userinfobot orqali o'z IDingizni bilib olishingiz mumkin
ADMIN_IDS=123456789,987654321

# Manbalarni tekshirish intervali (soniyalarda, default: 60 soniya = 1 daqiqa)
CHECK_INTERVAL_SECONDS=60

# Bir vaqtning o'zida nechta manba parallel so'ralishi (Semaphore limit)
MAX_CONCURRENT_REQUESTS=15

# Kross-dublikat o'xshashlik chegarasi (0.7 = 70% o'xshash bo'lsa ikkinchi xabar yuborilmaydi)
SIMILARITY_THRESHOLD=0.65
